generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String   @unique
  password      String
  phoneNumber   String   @unique
  role          Role     @default(CLIENT)
  isBlackListed Boolean  @default(false)
  pushToken     String?

  appointment Appointment[]
  barber      Barber?
}

model Service {
  id        String   @id @default(cuid())
  type      String
  duration  Int
  image     String
  show      Boolean  @default(true)

  appointment   Appointment[]
  barberService BarberService[]
}

model Day {
  id  String @id @default(cuid())
  day String @unique

  salonDays  SalonDay[]
  barberDays BarberDay[]
}

model Salon {
  id          String   @id @default(cuid())
  name        String   @unique
  address     String
  phoneNumber String   @unique
  city        String
  imgUrl      String

  barbers       Barber[]
  salonBreaks   SalonBreak[]
  salonClosures SalonClosure[]
  salonDays     SalonDay[]
}

model SalonDay {
  id      String @id @default(cuid())
  salonId String
  dayId   String

  openingTime String
  closingTime String
  isOpen      Boolean @default(true)

  barber Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  day    Day   @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model SalonClosure {
  id        String   @id @default(cuid())
  salonId   String
  startDate DateTime
  endDate   DateTime

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonBreak {
  id        String   @id @default(cuid())
  salonId   String
  breakDate DateTime
  startTime String
  endTime   String

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model Guest {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String

  appointment Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  clientId  String?
  guestId   String?
  barberId  String
  serviceId String
  date      DateTime
  startTime String
  endTime   String
  show      Boolean  @default(true)

  client  User?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  guest   Guest?  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, startTime])
  @@unique([barberId, date, endTime])
}

model Barber {
  id        String   @id @default(cuid())
  userId    String   @unique
  salonId   String
  imgUrl    String
  pseudo    String
  instagram String
  snapchat  String

  salon          Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment    Appointment[]
  barberBreaks   BarberBreak[]
  barberAbsences BarberAbsence[]
  barberDays     BarberDay[]
  barberServices BarberService[]
}

model BarberDay {
  id       String @id @default(cuid())
  barberId String
  dayId    String

  isWorking Boolean @default(false)

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  day    Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model BarberBreak {
  id        String   @id @default(cuid())
  barberId  String
  breakDate DateTime
  startTime String
  endTime   String

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

model BarberAbsence {
  id        String   @id @default(cuid())
  barberId  String
  startDate DateTime
  endDate   DateTime

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

model BarberService {
  id           String @id @default(cuid())
  barberId     String
  serviceId    String
  price        Float
  studentPrice Float

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
}

enum Role {
  CLIENT
  BARBER
  ADMIN
}
